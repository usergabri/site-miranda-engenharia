---
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import { site, whatsappLink } from '../../config/site';
import poster from '../../assets/img/calibracao-psv.jpeg';

const posterImg = await getImage({ src: poster, width: 1280, format: 'webp' });
---

<section class="hero dark" id="inicio" aria-labelledby="hero-title">
  <div class="hero__frame" data-hero-frame>
    <video
      class="hero__video"
      src="/videos/hero.mp4"
      poster={posterImg.src}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      data-hero-video></video>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="tech-grid hero__grid" aria-hidden="true"></div>

    <div class="hero__content container">
      <h1 class="hero__title display" id="hero-title">
        <span class="hero__line"><span data-hero-word>Inspecionar.</span></span>
        <span class="hero__line"><span data-hero-word>Documentar.</span></span>
        <span class="hero__line"><span data-hero-word class="accent">Regularizar.</span></span>
      </h1>

      <div class="hero__bottom">
        <div class="hero__copy">
          <p class="hero__sub">
            Sou o {site.engineer}, engenheiro mecânico especialista em <strong>NR-13</strong>. Inspeciono caldeiras, vasos
            de pressão e tubulações, emito laudos e ART e acompanho cada pendência até a regularização, em qualquer lugar
            do Brasil.
          </p>
          <p class="hero__cred">
            <span class="hero__cred-dot" aria-hidden="true"></span>
            Profissional Habilitado · <span class="mono">CREA {site.crea}</span>
          </p>
        </div>
        <div class="hero__actions" data-hero-actions>
          <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">
            Pedir orçamento
            <span class="btn__dot"><Icon name="tabler:brand-whatsapp" /></span>
          </a>
          <a class="btn btn--ghost" href="#servicos">
            Ver serviços
            <span class="btn__dot"><Icon name="lucide:arrow-down" /></span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero__meta container">
      <span aria-hidden="true">Base em {site.city} – {site.state}</span>
      <span class="hero__meta-line" aria-hidden="true"></span>
      <button class="hero__pause" type="button" data-hero-pause aria-label="Pausar vídeo de fundo">
        <Icon name="lucide:pause" class="i-pause" />
        <Icon name="lucide:play" class="i-play" />
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--ink-950);
    padding: 0;
  }
  .hero__frame {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    color: var(--text-on-dark);
    isolation: isolate;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
    transform-origin: 50% 40%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(5, 18, 22, 0.75) 0%, rgba(5, 18, 22, 0.15) 30%, rgba(5, 18, 22, 0.35) 55%, var(--ink-950) 100%),
      linear-gradient(90deg, rgba(5, 18, 22, 0.85) 0%, rgba(5, 18, 22, 0.2) 70%);
  }
  .hero__grid {
    z-index: -1;
    opacity: 0.35;
  }
  .hero__content {
    padding-top: 140px;
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  .hero__copy {
    display: grid;
    gap: 18px;
  }
  .hero__sub strong {
    color: #fff;
    font-weight: 600;
  }
  .hero__cred {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }
  .hero__cred .mono {
    color: var(--text-on-dark);
  }
  .hero__cred-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan-500);
  }
  .hero__title {
    font-size: clamp(2.9rem, min(11.2vw, 17svh), 10.5rem);
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__bottom {
    display: grid;
    gap: 28px;
    align-items: end;
  }
  .hero__sub {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    color: #c3d6db;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__meta {
    display: flex;
    justify-content: flex-end;
    padding-bottom: 20px;
  }
  .hero__meta > span {
    display: none;
  }
  .hero__pause {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    background: rgba(5, 18, 22, 0.55);
    color: var(--text-on-dark);
    cursor: pointer;
  }
  .hero__pause :global(svg) {
    width: 18px;
    height: 18px;
  }
  .hero__pause :global(.i-play),
  .hero__pause.is-paused :global(.i-pause) {
    display: none;
  }
  .hero__pause.is-paused :global(.i-play) {
    display: block;
  }
  @media (min-width: 900px) {
    .hero__bottom {
      grid-template-columns: 1fr auto;
      gap: 48px;
    }
    .hero__meta {
      align-items: center;
      gap: 20px;
      padding-bottom: 24px;
      font-size: 0.8rem;
      color: var(--muted-on-dark);
    }
    .hero__meta > span {
      display: block;
    }
    .hero__meta-line {
      flex: 1;
      height: 1px;
      background: var(--line-dark);
    }
  }
  @media (max-width: 420px) {
    .hero__actions .btn {
      width: 100%;
      justify-content: space-between;
    }
  }
  .js .hero__line > span {
    transform: translateY(105%);
  }
  @media (prefers-reduced-motion: reduce) {
    .js .hero__line > span {
      transform: none;
    }
  }
</style>
