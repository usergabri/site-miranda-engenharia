---
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import valve from '../../assets/img/matheus-valvula-seguranca.jpeg';

const videoPoster = await getImage({ src: valve, width: 1024, format: 'webp' });

const timeline = [
  { year: '2019', title: 'Engenharia Mecânica', text: 'Me formei pela Uningá, em Maringá – PR.' },
  { year: 'Fábrica', title: 'Anos no chão de fábrica', text: 'Manutenção, operação e os equipamentos reais da indústria, no dia a dia.' },
  { year: 'NR-13', title: 'Especialização', text: 'Inspeção de caldeiras, vasos de pressão e tubulações.' },
  { year: 'Hoje', title: 'Miranda Engenharia', text: 'Há 2 anos atendendo indústrias em todo o Brasil.' },
];
---

<section class="about section" id="sobre" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__content">
      <h2 class="h2" id="about-title" data-split>
        Eu conheço o chão de fábrica <span class="accent nowrap">por dentro.</span>
      </h2>
      <div class="about__text">
        <p>
          Antes de abrir a Miranda Engenharia, passei anos na manutenção e na operação industrial, convivendo com os
          equipamentos e com a pressão de manter uma planta rodando. Sei o que uma parada não programada custa.
        </p>
        <p>
          Por isso o meu laudo não fica na gaveta: entendo o equipamento, meço em campo, documento com rigor e acompanho
          cada pendência até a regularização, sem deixar você sozinho com a norma.
        </p>
      </div>

      <ol class="timeline">
        {
          timeline.map((t) => (
            <li class="timeline__item">
              <span class="timeline__year">{t.year}</span>
              <div>
                <h3 class="timeline__title">{t.title}</h3>
                <p class="timeline__text">{t.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="about__video" data-reveal>
      <video
        src="/videos/sobre.mp4"
        poster={videoPoster.src}
        muted
        loop
        playsinline
        preload="none"
        aria-label="Vídeo do engenheiro Matheus Miranda em serviço de campo"
        data-autoplay-visible></video>
      <button class="about__play" type="button" data-video-toggle aria-label="Reproduzir vídeo">
        <Icon name="lucide:pause" class="i-pause" />
        <Icon name="lucide:play" class="i-play" />
      </button>
      <figcaption>Em campo: inspeção de vasos de pressão.</figcaption>
    </figure>
  </div>
</section>

<style>
  .about {
    background: var(--paper);
  }
  .about__grid {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
    .about__video {
      position: sticky;
      top: 120px;
    }
  }
  .about__content {
    display: grid;
    gap: 28px;
  }
  .about__text {
    display: grid;
    gap: 16px;
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 62ch;
  }
  .timeline {
    list-style: none;
    padding: 0;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cyan-700);
    padding-top: 1px;
  }
  .timeline__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .timeline__text {
    color: var(--muted);
    font-size: 0.93rem;
  }

  .about__video {
    position: relative;
  }
  .about__video video {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--ink-900);
  }
  .about__video figcaption {
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .about__play {
    position: absolute;
    right: 16px;
    top: 16px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(5, 18, 22, 0.6);
    color: #fff;
    cursor: pointer;
  }
  .about__play :global(svg) {
    width: 20px;
    height: 20px;
  }
  .about__play :global(.i-play),
  .about__play.is-paused :global(.i-pause) {
    display: none;
  }
  .about__play.is-paused :global(.i-play) {
    display: block;
  }
</style>
