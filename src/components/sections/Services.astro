---
import { Icon } from 'astro-icon/components';
import { serviceGroups } from '../../data/content';
import { serviceMessage, whatsappLink } from '../../config/site';
---

<section class="services section" id="servicos" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head section-head--split">
      <h2 class="h2" id="services-title" data-split>
        Além da NR-13, o que mais a sua operação precisa
      </h2>
      <p class="lead">
        Exigências técnicas e legais de indústrias, empresas e prestadores de serviço, sempre com ART e documentação
        completa. Toque em um serviço para pedir o orçamento direto no WhatsApp.
      </p>
    </div>

    <div class="groups">
      {
        serviceGroups.map((group) => (
          <section class="group" data-reveal aria-label={group.title}>
            <div class="group__head">
              <h3 class="group__title">{group.title}</h3>
              <p class="group__text">{group.text}</p>
            </div>
            <ul class="group__list">
              {group.items.map((s) => (
                <li>
                  <a class="svc" href={whatsappLink(serviceMessage(s.title))} target="_blank" rel="noopener">
                    <span class="svc__icon" aria-hidden="true">
                      <Icon name={s.icon} />
                    </span>
                    <span class="svc__body">
                      <span class="svc__title">{s.title}</span>
                      <span class="svc__text">{s.text}</span>
                    </span>
                    <span class="svc__cta">
                      <span class="svc__cta-label">Pedir orçamento</span>
                      <Icon name="lucide:arrow-up-right" aria-hidden="true" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--surface);
  }
  .groups {
    border-top: 2px solid var(--text);
  }
  .group {
    display: grid;
    gap: 16px 48px;
    padding-block: clamp(24px, 3vw, 36px);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 960px) {
    .group {
      grid-template-columns: 0.75fr 1.25fr;
    }
  }
  .group__head {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .group__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .group__text {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 42ch;
  }
  .group__list {
    list-style: none;
    padding: 0;
  }
  .group__list li + li {
    border-top: 1px solid var(--line);
  }
  .svc {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 16px 12px;
    margin-inline: -12px;
    border-radius: 12px;
    transition: background 0.3s var(--ease-out);
  }
  .svc:hover,
  .svc:focus-visible {
    background: var(--cyan-50);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--paper);
    color: var(--cyan-700);
    transition:
      background 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .svc:hover .svc__icon {
    background: var(--cyan-500);
    color: var(--ink-950);
  }
  .svc__icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .svc__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .svc__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
  }
  .svc__text {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .svc__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cyan-700);
    white-space: nowrap;
  }
  .svc__cta :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.35s var(--ease-out);
  }
  .svc:hover .svc__cta :global(svg) {
    transform: translate(2px, -2px);
  }
  @media (max-width: 640px) {
    .svc__cta-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }
</style>
