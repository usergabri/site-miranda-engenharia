---
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import { record } from '../../data/content';
import photo from '../../assets/img/matheus-medicao-espessura.png';

// Campos no formato de uma placa de identificação de equipamento (NR-13)
const fields = [
  { label: 'Profissional habilitado', value: site.engineer },
  { label: 'Registro', value: `CREA ${site.crea}`, mono: true },
  { label: 'Formação', value: 'Engenharia Mecânica · Uningá, 2019' },
  { label: 'Especialidade', value: 'NR-13 · Caldeiras, vasos de pressão e tubulações' },
  { label: 'Base', value: `${site.city} – ${site.state}` },
  { label: 'Atendimento', value: site.coverage },
];
---

<section class="cred section" id="quem-assina" aria-labelledby="cred-title">
  <div class="container cred__grid">
    <div class="cred__intro">
      <h2 class="h2" id="cred-title" data-split>Quem assina cada laudo</h2>
      <p class="lead">
        A Miranda Engenharia é o meu nome e o meu CREA em cada documento. Eu vou até a sua planta, faço as medições e
        assino o que entrego. Você fala direto com o engenheiro responsável, do orçamento à regularização.
      </p>
      <figure class="cred__photo" data-reveal>
        <Image
          src={photo}
          alt="Matheus Miranda medindo a espessura de um vaso de pressão com aparelho de ultrassom"
          widths={[400, 640, 900]}
          sizes="(min-width: 1000px) 34vw, 100vw"
        />
      </figure>
    </div>

    <div class="plate" data-reveal role="group" aria-label="Placa de identificação do profissional">
      <span class="plate__rivet plate__rivet--tl" aria-hidden="true"></span>
      <span class="plate__rivet plate__rivet--tr" aria-hidden="true"></span>
      <span class="plate__rivet plate__rivet--bl" aria-hidden="true"></span>
      <span class="plate__rivet plate__rivet--br" aria-hidden="true"></span>

      <div class="plate__head">
        <span class="plate__brand">Miranda Engenharia</span>
        <span class="plate__kind">Placa de identificação · Profissional Habilitado</span>
      </div>

      <dl class="plate__fields">
        {
          fields.map((f) => (
            <div class="plate__field">
              <dt>{f.label}</dt>
              <dd class:list={{ mono: f.mono }}>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="plate__record">
        <p class="plate__record-title">Histórico de operação</p>
        <dl class="plate__featured">
          {
            record.featured.map((r) => (
              <div>
                <dt class="plate__value-label">{r.label}</dt>
                <dd class="plate__value">{r.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="plate__supporting">{record.supporting.join(' · ')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cred {
    background: var(--paper);
  }
  .cred__grid {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .cred__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
  .cred__intro {
    display: grid;
    gap: 24px;
  }
  .cred__photo {
    margin-top: 12px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--line);
  }
  .cred__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 30%;
  }

  /* Placa de aço escovado, como a de identificação dos equipamentos */
  .plate {
    position: relative;
    padding: clamp(28px, 3.6vw, 48px);
    border-radius: 14px;
    color: #14262c;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 3px),
      linear-gradient(160deg, #e7ecee 0%, #cfd8db 48%, #e1e7e9 100%);
    border: 1px solid #b4c1c5;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 0 0 6px rgba(255, 255, 255, 0.18),
      inset 0 0 0 7px rgba(20, 38, 44, 0.16),
      0 2px 4px rgba(5, 18, 22, 0.06),
      0 28px 56px -28px rgba(5, 18, 22, 0.35);
  }
  .plate__rivet {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #f4f7f8, #9aa9ae 70%);
    box-shadow:
      0 1px 1px rgba(5, 18, 22, 0.35),
      inset 0 -1px 1px rgba(5, 18, 22, 0.2);
  }
  .plate__rivet--tl {
    top: 16px;
    left: 16px;
  }
  .plate__rivet--tr {
    top: 16px;
    right: 16px;
  }
  .plate__rivet--bl {
    bottom: 16px;
    left: 16px;
  }
  .plate__rivet--br {
    bottom: 16px;
    right: 16px;
  }
  .plate__head {
    display: grid;
    gap: 4px;
    padding: 0 16px 18px;
    border-bottom: 2px solid #14262c;
    text-align: center;
  }
  .plate__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .plate__kind {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3d5157;
  }
  .plate__fields {
    display: grid;
    margin: 0;
  }
  .plate__field {
    display: grid;
    grid-template-columns: minmax(130px, 0.7fr) 1.3fr;
    gap: 16px;
    padding: 12px 4px;
    border-bottom: 1px solid rgba(20, 38, 44, 0.22);
    align-items: baseline;
  }
  .plate__field dt {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3d5157;
  }
  .plate__field dd {
    margin: 0;
    font-weight: 600;
    font-size: 1rem;
  }
  @media (max-width: 520px) {
    .plate__field {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  .plate__record {
    margin-top: 26px;
    padding: 22px 20px 20px;
    border: 2px solid #14262c;
    border-radius: 8px;
  }
  .plate__record-title {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3d5157;
    margin-bottom: 14px;
  }
  .plate__featured {
    display: grid;
    gap: 18px;
    margin: 0;
  }
  @media (min-width: 560px) {
    .plate__featured {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .plate__featured > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    justify-content: flex-end;
  }
  .plate__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .plate__value-label {
    font-size: 0.88rem;
    color: #3d5157;
    line-height: 1.35;
  }
  .plate__supporting {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(20, 38, 44, 0.22);
    font-size: 0.9rem;
    color: #2b3f45;
  }
</style>
