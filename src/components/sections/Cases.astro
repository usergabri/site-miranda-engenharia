---
import { Image } from 'astro:assets';
import CaseBody from '../CaseBody.astro';
import { cases } from '../../data/content';
import valve from '../../assets/img/matheus-valvula-seguranca.jpeg';

const [lead, ...others] = cases;
---

<section class="cases section dark" id="cases" aria-labelledby="cases-title">
  <div class="container">
    <div class="section-head section-head--split">
      <h2 class="h2" id="cases-title" data-split>
        Cronograma cumprido, laudo entregue, <span class="accent">pendência <span class="nowrap">resolvida.</span></span>
      </h2>
      <p class="lead">
        É o que os meus clientes mais destacam. Três trabalhos recentes, de 6 a 450 equipamentos, contados por quem
        contratou.
      </p>
    </div>

    <article class="case case--lead" data-reveal aria-labelledby={`case-${lead.id}`}>
      <figure class="case__media">
        <Image
          src={valve}
          alt="Matheus Miranda inspecionando a válvula de segurança de uma caldeira em planta industrial"
          widths={[480, 800, 1100]}
          sizes="(min-width: 1000px) 42vw, 100vw"
          data-parallax
        />
      </figure>
      <CaseBody c={lead} lead />
    </article>

    <div class="cases__pair">
      {
        others.map((c) => (
          <article class="case" data-reveal aria-labelledby={`case-${c.id}`}>
            <CaseBody c={c} />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cases {
    border-top: 1px solid var(--line-dark);
  }
  .case {
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-dark);
    background: var(--ink-900);
  }
  .case--lead {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    margin-bottom: 16px;
  }
  @media (min-width: 1000px) {
    .case--lead {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
    }
  }
  .case__media {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink-850);
  }
  @media (min-width: 1000px) {
    .case__media {
      aspect-ratio: auto;
      min-height: 420px;
    }
  }
  .case__media :global(img) {
    width: 100%;
    height: 115%;
    object-fit: cover;
    object-position: 65% 50%;
  }
  .cases__pair {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .cases__pair {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.dialogOpen!) as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener('click', () => {
      dialog.showModal();
      window.dispatchEvent(new CustomEvent('menu:open'));
    });
    dialog.addEventListener('close', () => window.dispatchEvent(new CustomEvent('menu:close')));
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
