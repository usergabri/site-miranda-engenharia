---
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../config/site';
---

<a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
  <span class="wa-float__label">Fale com o engenheiro</span>
  <span class="wa-float__icon"><Icon name="tabler:brand-whatsapp" /></span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: clamp(16px, 2.5vw, 28px);
    bottom: clamp(16px, 2.5vw, 28px);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px;
    border-radius: 999px;
    background: var(--ink-950);
    color: #fff;
    box-shadow: 0 12px 32px -8px rgba(5, 18, 22, 0.5);
    border: 1px solid var(--line-dark);
    transition: transform 0.35s var(--ease-out);
  }
:global(html:has(.menu:not([hidden]))) .wa-float {
    display: none;
  }
  .wa-float:hover {
    transform: translateY(-3px);
  }
  .wa-float__label {
    display: none;
    padding-left: 14px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .wa-float__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
  }
  .wa-float__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25d366;
    animation: wa-pulse 2.4s var(--ease-out) infinite;
  }
  .wa-float__icon :global(svg) {
    width: 26px;
    height: 26px;
  }
  @media (min-width: 900px) {
    .wa-float__label {
      display: block;
    }
  }
  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
</style>
